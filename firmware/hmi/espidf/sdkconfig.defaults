# Match official Waveshare 4.3C ESP-IDF demo baseline; still verify delivered PCB.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
# No OTA partition table selected for experimental M0/M1; use known-good
# factory recovery before any flash. No automatic user-data migration.
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
